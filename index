                        </div>
                        <h3>VISA Card</h3>
                        <p class="price">₹3200</p>
                        <button class="btn btn-buy" onclick="showPage('')"> Currently Unavailable</button>
                    </div>


                    <!-- Card 5 -->
                    <div class="product-card">
                        <div class="gift-card-visual">
                            <div class="card-chip"></div>
                            <div class="card-number">XXXX-XXXX-XXXX-9012</div>
                            <div class="card-details">
                                <span>CVV: XXX</span>
