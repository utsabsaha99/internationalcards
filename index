                        <p class="price">₹800</p>
                        <button class="btn btn-buy" onclick="showPage('payment')">Buy Now</button>
                    </div>

                    <!-- Card 3 -->
                    <div class="product-card">
                        <div class="gift-card-visual">
                            <div class="card-chip"></div>
                            <div class="card-number">XXXX-XXXX-XXXX-5678</div>
                            <div class="card-details">
                                <span>CVV: XXX</span>
                                <span>Expiry: XX/XX</span>
                            </div>
                            <div class="card-balance">Balance= Rs. 15670</div>
                        </div>
                        <h3>Standerd Card</h3>
                        <p class="price">₹1600</p>
                        <button class="btn btn-buy" onclick="showPage('payment')">Buy Now</button>
                    </div>

<!-- Card 4 -->
                    <div class="product-card">
                        <div class="gift-card-visual">
                            <div class="card-chip"></div>
                            <div class="card-number">XXXX-XXXX-XXXX-1152</div>
                            <div class="card-details">
